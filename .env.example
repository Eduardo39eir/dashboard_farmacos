# Gere uma chave: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Copie a URI PostgreSQL no botão Connect do Supabase (Session pooler).
# Codifique caracteres especiais da senha na URI. Nunca exponha esta URL no JavaScript.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:SENHA@HOST_DO_SESSION_POOLER:5432/postgres?sslmode=require
